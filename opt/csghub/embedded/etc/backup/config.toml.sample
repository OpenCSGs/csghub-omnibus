{{/* csghub-backup 配置：reconfigure 渲染一次，runit 调度与 csghub-ctl 手动命令共用。
     凭据推导链必须与各服务自身保持一致（防漂移，锁定测试 TestBackupConfigRendersCredentials）：
     - gitaly token     ← 显式 .backup.sources.gitaly.token 优先，空则与 gitaly config 同表达式
     - minio secret_key ← 显式 .backup.sources.minio.secret_key 优先，空则与 minio prestart 同推导 */}}

[backup]
# Local scratch space for staging during backup and extraction during restore.
# NOT snapshot storage — snapshots live in [storage.*] backends.
work_dir = {{ .backup.work_dir | default "/var/opt/csghub/backup/work" | quote }}
concurrent = {{ .backup.concurrent | default 1 }}

[schedule]
cron = {{ .backup.schedule | default "" | quote }}

[sources.postgresql]
host = {{ .backup.sources.postgresql.host | default "127.0.0.1" | quote }}
port = {{ .backup.sources.postgresql.port | default 5432 }}
user = {{ .backup.sources.postgresql.user | default "csghub" | quote }}
password = {{ .backup.sources.postgresql.password | default (pbkdf2 (.backup.sources.postgresql.user | default "csghub") "opencsg" 2048 8) | quote }}
backup = {{ eq (.backup.sources.postgresql.backup | toString) "false" | ternary false true }}

[sources.gitaly]
address = {{ .backup.sources.gitaly.address | default "127.0.0.1:8075" | quote }}
token = {{ .backup.sources.gitaly.token | default (pbkdf2 "gitaly" "opencsg" 2048 8) | quote }}
storage = {{ .backup.sources.gitaly.storage | default "default" | quote }}
backup = {{ eq (.backup.sources.gitaly.backup | toString) "false" | ternary false true }}

[sources.minio]
endpoint = {{ .backup.sources.minio.endpoint | default "http://127.0.0.1:9001" | quote }}
access_key = {{ .backup.sources.minio.access_key | default "minio" | quote }}
secret_key = {{ .backup.sources.minio.secret_key | default (pbkdf2 "minio" "opencsg" 2048 8) | quote }}
alias = {{ .backup.sources.minio.alias | default "csghub" | quote }}
secure = {{ .backup.sources.minio.secure | default false }}
# Empty = back up all buckets; or list them explicitly.
buckets = {{ .backup.sources.minio.buckets | default list | toJson }}
# Buckets to skip in backup-all mode; ignored when buckets is set.
# REQUIRED when [storage.s3] writes to this same MinIO: add its bucket here
# (e.g. ["csghub-backup"]), or every backup copies all previous snapshots
# into the new one — sizes snowball every run. Note also: snapshots stored
# on this same MinIO share its fate — if MinIO loses data, the snapshots
# are lost with it. Use a separate storage system for real disaster recovery.
ignore_buckets = {{ .backup.sources.minio.ignore_buckets | default list | toJson }}
backup = {{ eq (.backup.sources.minio.backup | toString) "false" | ternary false true }}

[storage.local]
# Local filesystem snapshots at <backup_root>/snapshots/<id>.tar.gz.
enabled = {{ .backup.storage.local.enabled | default true }}
backup_root = {{ .backup.storage.local.backup_root | default "/var/opt/csghub/backup" | quote }}
keep = {{ .backup.storage.local.keep | default 1 }}

[storage.s3]
# S3-compatible object storage snapshots at <bucket>/<prefix>/<id>.tar.gz.
# Works with AWS S3, MinIO, Ceph, Alibaba OSS, etc. Enable together with
# [storage.local] to mirror snapshots to both backends.
# WARNING: if this is the SAME MinIO as [sources.minio], the snapshot bucket
# must be listed in sources.minio.ignore_buckets — see the warning there.
# Caveat: snapshots then live on the same MinIO as the data they protect.
# If MinIO loses data, the snapshots are lost too — use a separate storage
# system for real disaster recovery.
enabled = {{ .backup.storage.s3.enabled | default false }}
endpoint = {{ .backup.storage.s3.endpoint | default "" | quote }}
region = {{ .backup.storage.s3.region | default "" | quote }}
bucket = {{ .backup.storage.s3.bucket | default "" | quote }}
prefix = {{ .backup.storage.s3.prefix | default "csghub-backup" | quote }}
access_key = {{ .backup.storage.s3.access_key | default "" | quote }}
secret_key = {{ .backup.storage.s3.secret_key | default "" | quote }}
keep = {{ .backup.storage.s3.keep | default 7 }}

[logging]
# file 留空：日志走 stderr → runit svlogd（/var/log/csghub/backup），避免 backup 用户写 root 属主目录
level = {{ .backup.log.level | default "info" | quote }}
file = ""
