ARG REGISTRY=docker.io
ARG OS_RELEASE=ubuntu:22.04
# csghub-backup publishes its multi-arch image from its own GitLab CI
# (tag-triggered). Component CI only passes REGISTRY + the environments
# below, so the source registry location lives here as the default.
ARG BACKUP_SOURCE_REGISTRY=git-devops.opencsg.com:5050/product/infra/deployment-automation/toolbox/csghub-backup
ARG BACKUP_VERSION=v0.1.0

FROM ${BACKUP_SOURCE_REGISTRY}:${BACKUP_VERSION} AS csghub-backup

FROM ${REGISTRY}/${OS_RELEASE}

ENV CSGHUB_HOME=/opt/csghub
ENV CSGHUB_EMBEDDED=${CSGHUB_HOME}/embedded
ENV CSGHUB_SRV_HOME=${CSGHUB_EMBEDDED}/sv

RUN mkdir -p ${CSGHUB_SRV_HOME}/backup/bin

# Static Go binary only. Runtime dependencies (pg_dumpall, gitaly-backup, mc)
# already ship in the omnibus image via the postgresql/gitaly/minio components.
COPY --from=csghub-backup /usr/bin/csghub-backup ${CSGHUB_SRV_HOME}/backup/bin/
RUN chmod +x ${CSGHUB_SRV_HOME}/backup/bin/csghub-backup